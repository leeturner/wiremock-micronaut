{
  "name": "message-only",
  "trigger": {
    "type": "http-request",
    "requestPattern": { "method": "GET", "urlPath": "/never" }
  },
  "actions": [
    {
      "type": "send",
      "message": { "body": { "data": "unused" } },
      "channelTarget": {
        "type": "request-initiated",
        "channelType": "sse",
        "requestPattern": { "urlPath": "/never-stream" }
      }
    }
  ]
}
